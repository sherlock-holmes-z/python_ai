# 文件说明：用环境变量隔离代码与部署配置，保证换电脑时只需复制模板即可启动。
# 复制为 .env 后填写真实凭据；模板只保留占位值，不要提交包含密钥的 .env。
APP_NAME=FastAPI ORM CRUD
APP_ENV=development
LOG_LEVEL=INFO
CACHE_TTL_SECONDS=300

# MySQL：商品主数据
MYSQL_HOST=192.168.100.102
MYSQL_PORT=3306
MYSQL_USER=fastapi_app
MYSQL_PASSWORD=CHANGE_ME_MYSQL_PASSWORD
MYSQL_DATABASE=fastapi_orm

# PostgreSQL：商品操作审计
POSTGRES_HOST=192.168.100.102
POSTGRES_PORT=5432
POSTGRES_USER=fastapi_app
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DATABASE=fastapi_orm

# Redis：商品详情缓存；无密码时保留空值
REDIS_HOST=192.168.100.102
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
